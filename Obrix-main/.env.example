# Server-side only. Do not prefix these values with NEXT_PUBLIC_.
# Set this to the full message endpoint exposed by your ElizaOS service.
ELIZAOS_CHAT_URL=
# Optional bearer token for a protected ElizaOS endpoint.
ELIZAOS_API_TOKEN=

# Server-side only: URL of the deployed ElizaOS bridge, ending in /chat.
ELIZAOS_CHAT_URL=
# Must match OBRIX_COPILOT_TOKEN in the ElizaOS service environment.
OBRIX_COPILOT_TOKEN=
